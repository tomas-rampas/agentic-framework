{
  "description": "Agentic-framework enforcement hooks: peer-review Stop gate, verdict recorder, session context, delegation hints.",
  "hooks": {
    "Stop": [
      { "hooks": [ { "type": "command", "command": "pwsh", "args": ["-NoProfile", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/stop-peer-review-gate.ps1"], "timeout": 15 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Task|Agent", "hooks": [ { "type": "command", "command": "pwsh", "args": ["-NoProfile", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/record-subagent-run.ps1"], "timeout": 10 } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "pwsh", "args": ["-NoProfile", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/record-subagent-run.ps1"], "timeout": 10 } ] }
    ],
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "pwsh", "args": ["-NoProfile", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/session-start-context.ps1"], "timeout": 10 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Write|Edit", "hooks": [ { "type": "command", "command": "pwsh", "args": ["-NoProfile", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/pretooluse-delegation-hint.ps1"], "timeout": 10 } ] }
    ]
  }
}
